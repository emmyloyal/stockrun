# X Layer
XLAYER_RPC=https://rpc.xlayer.tech
CHAIN_ID=196
DEPLOYER_PRIVATE_KEY=            # never commit a real key

# TapeOut (fill after creation — see docs/TAPEOUT_NOTES.md)
TAPEOUT_FACTORY=                 # verify
PROCESSOR_ADDRESS=
RESTOCK_GUARD_ID=
PICKUP_CHECK_ID=
DELIVERY_CHECK_ID=

# Vault
STABLECOIN_ADDRESS=              # stablecoin on X Layer — verify
VAULT_ADDRESS=
AGENT_PRIVATE_KEY=
CHECK_SERVICE_PRIVATE_KEY=

# AI + messaging
GEMINI_API_KEY=                   # aistudio.google.com > Get API key (never commit)
GEMINI_MODEL=                     # optional; default gemini-3.8-flash
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_RECIPIENT=          # your own number, international format without +, e.g. 2348012345678
WHATSAPP_VERIFY_TOKEN=            # any random string; you type the same one into Meta's webhook form
WHATSAPP_APP_SECRET=              # Meta app > App settings > Basic > App secret (never commit)
WEBHOOK_PORT=8787
TERMII_API_KEY=                    # Termii dashboard > API settings (never commit). Sends sign-in codes by SMS in Nigeria
TERMII_SENDER_ID=                  # approved sender ID, e.g. StockRun (Termii > Sender ID; approval takes a few days)
TERMII_CHANNEL=dnd                 # dnd reaches Do-Not-Disturb lines (needs DND-approved sender ID); generic otherwise
TERMII_BASE_URL=                   # only if your Termii dashboard shows a different base URL than https://api.ng.termii.com
GMAIL_CLIENT_ID=                   # Google Cloud OAuth client (Desktop app). Sends sign-in codes by email, no KYC
GMAIL_CLIENT_SECRET=               # same OAuth client (never commit)
GMAIL_REFRESH_TOKEN=               # written by `cd agent && npm run gmail:auth` (never commit)
GMAIL_FROM=                        # the sending Gmail address; also written by gmail:auth
SUPPORT_EMAIL=                     # shown in the app for help; empty = stockrun.codes@gmail.com
COIN_VAULT_CAP_USD=50              # most a buyer's coin vault may hold (the vault is unaudited); COIN_ORDERS=off turns coins off
GOOGLE_MAPS_API_KEY=               # AI seller hunt: Places API (New) key, restricted to that API (billing card needed)
SELLER_WEB_SEARCH=off              # "on" lets the hunt also search the web with Gemini (needs billing on the Gemini key)
HUNT_PER_USER_DAILY=20             # AI seller searches per person per day (each one costs Google lookups)
HUNT_SITE_DAILY=300                # AI seller searches across the whole site per day
SELLER_APPROVAL_DELAY_HOURS=0      # hours before a seller a buyer adds can be paid (0: record a deal and lock at once; the coin vault uses 24)
PAYSTACK_CHARGE_BUYER=1            # buyers pay Paystack's deposit charge on top (0: StockRun absorbs it)
WITHDRAW_DAILY_NAIRA=500000        # most one person can withdraw to their bank in 24 hours
WITHDRAW_REVIEW_OVER_NAIRA=200000  # a withdrawal over this waits for an admin to approve it (Admin → Buyer withdrawals)
FEE_PERCENT=1.5                    # StockRun's service fee per purchase, paid by the buyer on what is collected
FEE_MIN_NAIRA=100                  # smallest fee per order
FEE_MAX_NAIRA=10000                # largest fee per order
LISTING_FEE_NAIRA=1000             # what a business pays to keep its store listed (after an admin approves it)
LISTING_DAYS=30                    # how long each payment keeps the store live
ADMIN_EMAILS=                      # comma-separated email sign-ins that see the Admin tab (orders, seller payouts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                  # Twilio number or sender ID that sign-in codes come from
SMS=                              # set to "console" to print sign-in codes on the server instead of sending SMS

# Real-account server (agent: npm run serve:xlayer)
SERVER_SECRET=                    # 32+ random characters; protects sign-in codes (never commit)
SUPPLIER_PAYOUT_ADDRESS=          # StockRun's off-ramp account that supplier payments go to
NGN_PER_USD=                      # naira per US dollar, for USDT0 amounts
DB_FILE=                          # optional; default agent/data/stockrun.db
SECURE_COOKIES=                   # 1 when served over HTTPS
APP_PORT=8080

# Delivery companies (agent/src/logistics/)
SENDRELAY_API_KEY=                # dashboard > API Keys; sk_test_... = simulated riders, no money (never commit)
SENDRELAY_WEBHOOK_SECRET=         # whsec_..., shown once when the webhook is registered
SENDRELAY_DESK_PRIVATE_KEY=       # mainnet only: StockRun's on-chain key for Sendrelay (signs pickups/arrivals; needs a little OKB; never commit)

# Naira deposits (agent/src/money/paystack.ts)
PAYSTACK_SECRET_KEY=              # Paystack dashboard > Settings > API Keys & Webhooks; sk_test_... moves no real money (never commit)
PAYSTACK_PUBLIC_KEY=              # pk_test_...
PUBLIC_URL=                       # where buyers return after paying, e.g. https://stockrun.onrender.com
